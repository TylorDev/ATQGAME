{
  "name": "arena-rpg-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "MVP de movimiento RPG 3D para navegador y Electron",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "npm run typecheck && vite build --outDir dist-web",
    "preview": "electron-vite preview",
    "preview:web": "vite preview --outDir dist-web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-virtual": "^3.14.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0",
    "sass": "^1.102.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
